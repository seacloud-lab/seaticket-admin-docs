COMPOSE_FILE='caddy.yml,seaqa-web.yml'
COMPOSE_PATH_SEPARATOR=','

# system settings
TIME_ZONE=UTC

# SeaTicket server configuration
JWT_PRIVATE_KEY=
SECRET_KEY=
SEATICKET_SERVER_HOSTNAME=
SEATICKET_SERVER_PROTOCOL=http
ENABLE_NOTIFICATION_SERVER=false

# Portal routing values used by Docker Compose and Caddy.
PORTAL_SERVICE_ROOT_DOMAIN=portal-seaticket.com
PORTAL_CERTS_VOLUME=/opt/caddy-certs

# Non-SeaTicket components configuration

## SeaTicket components configuration (JWT_PRIVATE_KEY of SeaDB should be the same as SeaTicket)
SEADB_SERVER_URL=
SEADB_SERVER_ACCESS_TOKEN=

## Database (MySQL)
MYSQL_DB_HOST=
MYSQL_DB_PORT=3306
MYSQL_DB_USER=seaticket
MYSQL_DB_PASSWORD=

## Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

## S3
S3_HOST=
S3_FILE_BUCKET=
S3_WEB_CRAWL_BUCKET=
S3_KEY_ID=
S3_SECRET_KEY=

## SeaSearch
SEASEARCH_URL=
SEASEARCH_TOKEN=

## Jira (Atlassian OAuth 2.0)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URL=

## Linear (OAuth 2.0)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URL=

## GitHub App
GITHUB_APP_NAME=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
